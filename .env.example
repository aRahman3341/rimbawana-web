# Salin jadi .env.local lalu isi (JANGAN di-commit). Nilai ada di Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA - hanya di .env.local dan Environment Variables Vercel
SUPABASE_SERVICE_ROLE_KEY=
# Domain email teknis untuk login nama adat (ubah jika Supabase menolak)
EMAIL_DOMAIN_TEKNIS=anggota.invalid
